<Window x:Class="Minecraft_random_texturepacks.custom_windows.OutputFolderSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Minecraft_random_texturepacks.custom_windows"
        mc:Ignorable="d"
        Title="" WindowStyle="None" WindowStartupLocation="CenterScreen" SizeToContent="WidthAndHeight" ResizeMode="NoResize" AllowsTransparency="True" KeyDown="Window_KeyDown">

    <Window.Resources>
        <ResourceDictionary Source="/MinecraftStyles.xaml"/>
    </Window.Resources>

    <Window.Effect>
        <DropShadowEffect ShadowDepth="0" BlurRadius="20" Opacity="0.5"/>
    </Window.Effect>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" Duration="0:0:0.08" From="0" To="1"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border Background="{StaticResource MinecraftDarkGrayBrush}" BorderBrush="{StaticResource MinecraftGrayBrush}" BorderThickness="4" CornerRadius="0">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource MinecraftButtonStyle}">
                    <Setter Property="Padding" Value="20,7"/>
                    <Setter Property="FontSize" Value="22"/>
                </Style>
            </Grid.Resources>

            <!-- Heading -->
            <TextBlock Grid.Row="0" Style="{StaticResource MinecraftHeaderStyle}" FontSize="30" Text="Umístění pro vygenerované texturepacky:" Margin="10"/>

            <!-- Input text box -->
            <TextBox Grid.Row="1" Style="{StaticResource MinecraftTextBoxStyle}" FontSize="20" MaxWidth="1200" Margin="5,10,5,10" Text="{Binding SelectedFolderPath}" d:Text="C:\Users\User\AppData\Roaming\.minecraft\resourcepacks"/>

            <!-- Control buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="SelectFolderButton" Content="Najít složku" Click="SelectFolderButton_Click" Background="#FF928926" ToolTip="Otevře průzkumník souborů pro výběr cílové složky"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Zrušit" Click="CancelButton_Click" ToolTip="Zruší výběr složky a ponechá cílovou složku beze změny"/>
                <Button x:Name="SelectButton" Content="Potvrdit" Click="SelectButton_Click" ToolTip="Potvrdí vybranou složku a nastaví ji jako cílovou složku pro vygenerované texturepacky"/>
            </StackPanel>

        </Grid>
    </Border>
</Window>
