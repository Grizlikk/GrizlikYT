<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Nasobilka"
        x:Class="Nasobilka.MainWindow"
        mc:Ignorable="d"
        Title="Násobilka" Height="500" Width="750" Background="#FFE2E2E2" MinHeight="475" MinWidth="700">
    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}" x:Key="HeadingTextStyle">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="60"/>
            <Setter Property="Margin" Value="5,0,5,0"/>
        </Style>
        <Style TargetType="{x:Type TextBlock}" x:Key="ScoreTextStyle">
            <Setter Property="Grid.Row" Value="3"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="10,10,10,0"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="{x:Type Button}" x:Key="AnswerOptionButtonStyle">
            <Style.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Style.Resources>
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="FontSize" Value="82"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="15,10,15,10"/>
            <Setter Property="Background" Value="#FFCEC8FC"/>
        </Style>
        <Style TargetType="{x:Type Button}" x:Key="GameControlButtonStyle">
            <Style.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Style.Resources>
            <Setter Property="Grid.Row" Value="2"/>
            <Setter Property="Grid.ColumnSpan" Value="3"/>
            <Setter Property="Margin" Value="100,10,100,10"/>
            <Setter Property="FontSize" Value="50"/>
            <Setter Property="Background" Value="#FFD0D0D0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <WrapPanel x:Name="HeadingWrapPanel" Orientation="Horizontal" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="HeadingTextBlock" Style="{StaticResource HeadingTextStyle}">Násobilka</TextBlock>
            <TextBlock x:Name="HeadingTextBlockBold" Style="{StaticResource HeadingTextStyle}" FontWeight="Bold"></TextBlock>
        </WrapPanel>

        <Button x:Name="AnswerOption1" Style="{StaticResource AnswerOptionButtonStyle}" Grid.Column="0" Click="AnswerButton_Click" Tag="0">???</Button>
        <Button x:Name="AnswerOption2" Style="{StaticResource AnswerOptionButtonStyle}" Grid.Column="1" Click="AnswerButton_Click" Tag="1">???</Button>
        <Button x:Name="AnswerOption3" Style="{StaticResource AnswerOptionButtonStyle}" Grid.Column="2" Click="AnswerButton_Click" Tag="2">???</Button>

        <Button x:Name="GameControlButton" Content="Klikněte pro start hry" Click="GameControlButton_Click">
            <Button.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Button.Resources>
            <Button.Style>
                <StaticResource ResourceKey="GameControlButtonStyle"/>
            </Button.Style>
        </Button>

        <TextBlock x:Name="ScoreTextBlock" Style="{StaticResource ScoreTextStyle}" Grid.Column="0" HorizontalAlignment="Right"><Run Text="Skóre: 0"/></TextBlock>
        <TextBlock x:Name="HighScoreTextBlock" Style="{StaticResource ScoreTextStyle}" Grid.Column="2" HorizontalAlignment="Left"><Run Text="Rekord: 0"/></TextBlock>
    </Grid>
</Window>
