<Window x:Class="Náročná_aplikace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Náročná_aplikace"
        mc:Ignorable="d"
        Width="600" MinWidth="600" Height="600" MinHeight="600"
        Background="#111318"
        Foreground="#E8EAED"
        Title="Náročná aplikace">

    <Window.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#111318"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#191C22"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#292D36"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#8B919D"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#5B8DEF"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#6E9CF5"/>

        <!-- Button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="Margin" Value="0,15,0,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#FF5B1A1A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF761C1C"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#22252C"/>
            <Setter Property="BorderBrush" Value="#343943"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#C8CCD4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="5,5,10,5"/>
        </Style>

        <!-- Label -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#FFD5D5D5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

    </Window.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Velice profesionální aplikace" FontSize="28" FontWeight="Bold" Foreground="#F2F3F5" HorizontalAlignment="Center"/>
            <TextBlock Text="která si zaslouží like, odběr a nějaký pozitivní komentář :)" Margin="0,5,0,0" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22">
                <StackPanel>
                    <TextBlock Text="NASTAVENÍ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,14"/>
                    <TextBlock Text="Režim zpracování" FontSize="13" Margin="0,0,0,7"/>

                    <ComboBox SelectedIndex="{Binding Path=ProcessingSelectionIndex}">
                        <ComboBoxItem Content="Synchronní"/>
                        <ComboBoxItem Content="Asynchronní"/>
                        <ComboBoxItem Content="Paralelní"/>
                    </ComboBox>

                    <TextBlock Text="Další možnosti" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,28,0,8"/>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="Zaškrkávací políčko 1"/>
                            <CheckBox Content="Zaškrkávací políčko 2"/>
                            <CheckBox Content="Zaškrkávací políčko 3"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="Posuvník"/>
                            <Slider x:Name="Slider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="5"/>
                            <Label Grid.Column="2" Content="{Binding ElementName=Slider, Path=Value}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Tlačítko 1" Padding="5" Margin="5" Width="80" HorizontalAlignment="Left" Click="Button_Click"/>
                            <Button Content="Tlačítko 2" Padding="5" Margin="5" Width="80" HorizontalAlignment="Left" Click="Button_Click"/>
                            <Button Content="Tlačítko 3" Padding="5" Margin="5" Width="80" HorizontalAlignment="Left" Click="Button_Click"/>
                            <Button Content="Tlačítko 4" Padding="5" Margin="5" Width="80" HorizontalAlignment="Left" Click="Button_Click"/>
                            <Button Content="Tlačítko 5" Padding="5" Margin="5" Width="80" HorizontalAlignment="Left" Click="Button_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="StartProcessingButton" Content="Zahájit výpočet 1 000 000. prvočísla" Style="{StaticResource PrimaryButtonStyle}" Click="StartProcessingButton_Click"/>

                    <Button x:Name="CancelProcessingButton" Content="Zrušit výpočet" Style="{StaticResource SecondaryButtonStyle}" Click="CancelProcessingButton_Click"/>

                    <Label Content="{Binding Path=ProgressLabelText}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
